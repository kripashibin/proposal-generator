# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored — never commit real secrets.

# Supabase project (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (AI Studio) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe (use test-mode keys for local dev) - https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Get this by running `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# locally (it prints the secret). In production, create a webhook endpoint in the
# Stripe dashboard pointing at your deployed URL and use that endpoint's secret instead.
STRIPE_WEBHOOK_SECRET=

# Base URL of this app, used to build public proposal links and Stripe redirect URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
